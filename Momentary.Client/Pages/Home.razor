@page "/"
@inject FirebaseAuthenticationService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>
<AuthorizeView>
    <NotAuthorized>
        <h3>ログインが必要です</h3>
        <button @onclick="SignIn">Googleでログイン</button>
    </NotAuthorized>
    <Authorized>
        <h1>みんなの投稿</h1>
        <PostList />
        <button class="fab" @onclick="() => isDialogVisible = true">+</button>
        <PostDialog @bind-IsVisible="isDialogVisible" />
    </Authorized>
</AuthorizeView>
@code {
    private bool isDialogVisible = false;
    private async Task SignIn()
    {
        await AuthService.SignInWithGoogle();
    }
}