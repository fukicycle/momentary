@inherits LayoutComponentBase
@using Momentary.Infrastructure.Authentication
@inject FirebaseAuthenticationService AuthService
@inject NavigationManager NavManager

<div class="page">
    <header class="top-bar">
        @* アプリのタイトル。クリックするとホームに戻る *@
        <a class="title" href="/">Momentary</a>

        @* 認証されている場合のみ表示されるセクション *@
        <AuthorizeView>
            <Authorized>
                <div class="user-profile">
                    @* Googleアカウントのプロフィール写真 *@
                    <img src="@context.User.FindFirst("photoUrl")?.Value" alt="Profile" class="profile-avatar" />

                    @* Googleアカウントの表示名 *@
                    <span class="user-name">@context.User.Identity?.Name</span>

                    @* ログアウトボタン *@
                    <button class="logout-button" @onclick="HandleLogout">
                        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 0 24 24" width="24px" fill="#5f6368">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" />
                        </svg>
                        ログアウト
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="content">
        @* 各ページの内容がここにレンダリングされる *@
        @Body
    </main>
</div>

@code {
    private async Task HandleLogout()
    {
        await AuthService.SignOut();
        NavManager.NavigateTo("");
    }
}